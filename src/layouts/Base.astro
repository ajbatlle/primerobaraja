---

import '../styles/global.css';

interface Props {
  titulo: string;
  descripcion?: string;
}
const { titulo, descripcion = 'Primero Baraja, un podcast sobre tarot.' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.svg`.replace('//', '/')} />
  </head>
  <body>

    <slot />
  </body>
</html>
