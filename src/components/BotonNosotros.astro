---
import { Image } from 'astro:assets';
import nosotros from '../data/nosotros.json';
import foto from '../assets/nosotros.webp';
---

<button class="nosotros-boton" type="button" aria-expanded="false" aria-controls="panel-nosotros">
  Quiénes somos
</button>

<!-- El panel no se crea ni se destruye: esta siempre aqui, aparcado fuera del
     borde derecho, y entra deslizandose. `inert` lo saca del foco y del lector
     de pantalla mientras esta guardado, sin tocar nada visual. -->
<aside class="nosotros-panel" id="panel-nosotros" inert>
  <div class="nosotros-caja" role="dialog" aria-label="Quiénes somos">
    <button class="nosotros-cerrar" type="button" aria-label="Cerrar">×</button>
    <Image class="nosotros-foto" src={foto} width={620} alt={nosotros.fotoAlt} />
    <div class="nosotros-texto">
      <h2 class="nosotros-titulo">{nosotros.titulo}</h2>
      {nosotros.parrafos.map((p) => <p class="nosotros-parrafo">{p}</p>)}
      <p class="nosotros-firma">{nosotros.firma}</p>
      <ul class="nosotros-redes">
        {
          nosotros.instagram.map((r) => (
            <li>
              <a href={r.url} target="_blank" rel="noopener noreferrer">
                <span class="red-etiqueta">{r.etiqueta}</span>
                <span class="red-usuario">{r.usuario}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</aside>

<style>
  .nosotros-boton {
    position: fixed;
    top: clamp(16px, 3vmin, 32px);
    right: clamp(16px, 3vmin, 32px);
    z-index: 30;
    padding: 9px 16px;
    border: 1px solid rgba(17, 17, 17, 0.35);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(6px);
    color: #111;
    font: inherit;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background var(--t-corta) var(--curva),
      border-color var(--t-corta) var(--curva),
      scale var(--t-toque) var(--curva);
  }

  .nosotros-boton:hover {
    background: rgba(255, 255, 255, 0.42);
    border-color: rgba(17, 17, 17, 0.55);
  }

  .nosotros-boton:active { scale: 0.97; }
  .nosotros-boton:focus-visible { outline: 2px solid #111; outline-offset: 3px; }

  /* Sin velo: el entorno se queda tal cual estaba, visible y quieto, y el
     panel es un objeto mas que se desliza dentro del mismo espacio. */
  .nosotros-panel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 25;
    width: min(560px, 94vw);
    pointer-events: none;
  }

  .nosotros-caja {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: auto;
    overscroll-behavior: contain;
    background: #fff;
    box-shadow: -20px 0 60px rgba(0, 0, 0, 0.28);

    /* Aparcado justo fuera del borde. */
    translate: 100% 0;
    transition: translate var(--t-larga) var(--curva-larga);
  }

  .nosotros-panel[data-abierto='true'] { pointer-events: auto; }
  .nosotros-panel[data-abierto='true'] .nosotros-caja { translate: 0 0; }

  .nosotros-foto {
    display: block;
    width: 100%;
    height: auto;
    max-height: 38vh;
    object-fit: cover;
    flex: none;
  }

  .nosotros-texto {
    padding: clamp(20px, 3.4vw, 36px);
    color: #111;
  }

  .nosotros-titulo {
    margin: 0 0 14px;
    font-size: clamp(22px, 3vw, 30px);
    font-weight: 800;
  }

  .nosotros-parrafo {
    margin: 0 0 12px;
    font-size: 14px;
    line-height: 1.55;
  }

  .nosotros-firma {
    margin: 18px 0 0;
    font-size: 14px;
    font-style: italic;
  }

  .nosotros-redes {
    margin: 20px 0 0;
    padding: 16px 0 0;
    border-top: 1px solid rgba(17, 17, 17, 0.14);
    list-style: none;
    display: grid;
    gap: 8px;
  }

  .nosotros-redes a {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: inherit;
    text-decoration: none;
    font-size: 13px;
    transition: opacity var(--t-toque) var(--curva);
  }

  .nosotros-redes a:hover { opacity: 0.6; }
  .red-usuario { opacity: 0.55; }

  .nosotros-cerrar {
    position: absolute;
    top: 12px;
    right: 14px;
    z-index: 2;
    width: 34px;
    height: 34px;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    color: #111;
    font-size: 21px;
    line-height: 1;
    cursor: pointer;
    transition: background var(--t-toque) var(--curva);
  }

  .nosotros-cerrar:hover { background: #fff; }
</style>

<script>
  const boton = document.querySelector('.nosotros-boton');
  const panel = document.querySelector('.nosotros-panel');
  const cerrar = panel?.querySelector('.nosotros-cerrar');

  if (boton && panel) {
    function abrir() {
      panel.dataset.abierto = 'true';
      panel.removeAttribute('inert');
      boton.setAttribute('aria-expanded', 'true');
      cerrar?.focus();
    }

    function cerrarPanel() {
      panel.dataset.abierto = 'false';
      // El panel sigue en su sitio, solo se va deslizando; `inert` lo aparta
      // del teclado desde ya, sin esperar a que termine el movimiento.
      panel.setAttribute('inert', '');
      boton.setAttribute('aria-expanded', 'false');
      boton.focus();
    }

    boton.addEventListener('click', () => {
      if (panel.dataset.abierto === 'true') cerrarPanel();
      else abrir();
    });
    cerrar?.addEventListener('click', cerrarPanel);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && panel.dataset.abierto === 'true') cerrarPanel();
    });
  }
</script>
