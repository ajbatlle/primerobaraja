---
import { Image } from 'astro:assets';
import arcanos from '../data/arcanos.json';
import sitio from '../data/sitio.json';

const archivos = import.meta.glob('../assets/cartas/*.webp', { eager: true });
const img = (slug) => archivos[`../assets/cartas/${slug}.webp`].default;

// Publicados, del mas reciente al mas antiguo.
const publicados = arcanos.filter((a) => a.orden !== null).sort((a, b) => b.orden - a.orden);
const anteriores = publicados.slice(1);
---

<div class="insert">
  <iframe
    class="insert-embed"
    data-testid="embed-iframe"
    src={sitio.spotifyShow}
    width="100%"
    height="352"
    frameborder="0"
    allowfullscreen
    allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
    loading="lazy"
    title="Primero Baraja en Spotify"></iframe>

  <button class="desplegar" type="button" aria-expanded="false" aria-controls="lista-anteriores">
    <span class="desplegar-texto">Capítulos anteriores</span>
    <span class="desplegar-flecha" aria-hidden="true"></span>
  </button>

  <div class="ranura-lista" id="lista-anteriores">
    <ul class="anteriores">
      {
        anteriores.map((a, i) => (
          <li class="anterior" style={`--i:${i}`}>
            <a class="anterior-enlace" href={`#${a.slug}`} data-slug={a.slug}>
              <Image class="anterior-lamina" src={img(a.slug)} width={72} height={90} alt="" />
              <span class="anterior-texto">
                <span class="anterior-orden">{a.orden}</span>
                <span class="anterior-nombre">{a.nombre}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .insert {
    position: fixed;
    top: clamp(14px, 2.4vmin, 26px);
    left: clamp(14px, 2.4vmin, 26px);
    z-index: 20;
    width: clamp(260px, 23vw, 320px);
    /* Nunca mas alto que la pantalla: el escenario es la pantalla. */
    max-height: calc(100dvh - 2 * clamp(14px, 2.4vmin, 26px));
    display: flex;
    flex-direction: column;
    color: #111;
  }

  .insert-embed {
    display: block;
    width: 100%;
    height: 352px;
    border: none;
    border-radius: 12px;
    flex: none;
  }

  .desplegar {
    margin-top: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 8px 0;
    border: none;
    border-top: 1px solid rgba(17, 17, 17, 0.22);
    background: none;
    color: inherit;
    font: inherit;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: left;
    cursor: pointer;
    flex: none;
    transition: opacity var(--t-toque) var(--curva);
  }

  .desplegar:hover { opacity: 0.62; }
  .desplegar:focus-visible { outline: 2px solid #111; outline-offset: 3px; }

  .desplegar-texto { flex: 1; }

  .desplegar-flecha {
    width: 9px;
    height: 9px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    rotate: 45deg;
    translate: 0 -2px;
    transition: rotate var(--t-media) var(--curva), translate var(--t-media) var(--curva);
  }

  .desplegar[aria-expanded='true'] .desplegar-flecha {
    rotate: 225deg;
    translate: 0 1px;
  }

  /* Ranura de altura variable. El truco grid 0fr -> 1fr mide la lista sola,
     sin JS y sin saltos, pero solo gobierna la PRIMERA fila: por eso dentro
     va un unico hijo (la ul) y no los li sueltos. */
  .ranura-lista {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition: grid-template-rows var(--t-media) var(--curva);
  }

  .ranura-lista > * { min-height: 0; }

  .insert[data-abierto='true'] .ranura-lista {
    grid-template-rows: 1fr;
  }

  .anteriores {
    margin: 0;
    padding: 0;
    list-style: none;
    /* Si no cabe, se desplaza aqui dentro, no la pagina. */
    overflow-y: auto;
    overscroll-behavior: contain;
    max-height: calc(100dvh - 480px);
  }

  /* La ranura recorta: cada fila esta guardada arriba y baja a su sitio en
     cascada. No se funde, se desliza -por eso no hay opacidad aqui. */
  .anterior {
    translate: 0 -14px;
    transition: translate var(--t-media) var(--curva);
  }

  .insert[data-abierto='true'] .anterior {
    translate: 0 0;
    transition-delay: calc(var(--i) * var(--t-cascada));
  }

  .anterior-enlace {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 5px 0;
    color: inherit;
    text-decoration: none;
    transition: opacity var(--t-toque) var(--curva);
  }

  .anterior-enlace:hover { opacity: 0.6; }

  .anterior-lamina {
    display: block;
    width: 28px;
    height: auto;
    border-radius: 1px;
    flex: none;
  }

  .anterior-texto {
    display: flex;
    gap: 0.55em;
    align-items: baseline;
    font-size: 13px;
    min-width: 0;
  }

  .anterior-orden {
    font-variant-numeric: tabular-nums;
    opacity: 0.45;
  }

  .anterior-nombre {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>

<script>
  const insert = document.querySelector('.insert');
  const boton = insert?.querySelector('.desplegar');
  if (insert && boton) {
    boton.addEventListener('click', () => {
      const abierto = insert.dataset.abierto === 'true';
      insert.dataset.abierto = String(!abierto);
      boton.setAttribute('aria-expanded', String(!abierto));
    });
  }
</script>
