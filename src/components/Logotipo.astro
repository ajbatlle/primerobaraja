<style>
  .logotipo {
    /* Caja de tamaño cero: su origen ES el centro del glifo, asi que crecer
       y viajar giran alrededor de ese punto y la marca nunca salta. */
    position: fixed;
    left: 50%;
    top: 50%;
    z-index: 6;
    pointer-events: none;

    /* 797.9 / 126.6: lo que mide el SVG entero si el glifo mide --diametro. */
    --factor: 6.3025;
    --diametro: clamp(120px, 22vmin, 260px);
    --ancho-marca: calc(var(--diametro) * var(--factor));
    --ancho-final: var(--logo-final);
    --crecida: 1;

    /* scale y translate son propiedades separadas: la respuesta al toque
       puede ser corta y el viaje largo sin pisarse. */
    scale: var(--crecida);
    translate: 0 0;
    transition:
      scale var(--t-corta) var(--curva),
      translate var(--t-viaje) var(--curva-larga);
  }

  .logotipo-svg {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--ancho-marca);
    height: auto;
    overflow: visible;
    /* Ancla en el centro del glifo: 15.252% del ancho, 50% del alto. */
    transform: translate(-15.252%, -50%);
    transition: width var(--t-viaje) var(--curva-larga);
  }

  /* El disco crece desde el centro del glifo. Ni una opacidad. */
  .disco {
    fill: #111;
    transform-box: view-box;
    transform-origin: 121.7px 122.3px;
    transform: scale(0);
    transition: transform var(--t-viaje) var(--curva-larga);
  }

  /* La cortina se abre de izquierda a derecha desde el borde del disco. */
  .cortina {
    width: 0;
    transition: width var(--t-viaje) var(--curva-larga);
  }

  /* Y las letras se deslizan hacia su sitio por detras de ella, siempre a su
     tamaño final: nunca se deforman. */
  .letras-desliz {
    transform-box: view-box;
    transform: translateX(-96px);
    transition: transform var(--t-viaje) var(--curva-larga);
  }

  .letra { fill: #111; }
  .letra-roja { fill: #e52922; }

  .glifo {
    fill: #e52922;
    /* El script escribe aqui la rotacion, frame a frame. */
    transform-box: fill-box;
    transform-origin: 50% 50%;
  }

  .disparador {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--diametro);
    height: var(--diametro);
    transform: translate(-50%, -50%);
    border: none;
    border-radius: 50%;
    background: none;
    padding: 0;
    cursor: pointer;
    pointer-events: auto;
    -webkit-tap-highlight-color: transparent;
  }

  .disparador:focus-visible { outline: 2px solid #111; outline-offset: 6px; }

  /* "Entrar" vive dentro de una ranura con recorte: entra y sale deslizandose
     por ella, sin fundirse. */
  .ranura {
    position: absolute;
    left: 0;
    top: calc(var(--diametro) * 0.60);
    translate: -50% 0;
    display: block;
    overflow: hidden;
    padding: 0 0.3em;
    line-height: 1.5;
  }

  .pista {
    display: block;
    font-size: clamp(13px, 1.5vmin, 16px);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #111;
    white-space: nowrap;
    /* Guardada arriba, fuera del recorte. */
    translate: 0 -130%;
    transition: translate var(--t-corta) var(--curva);
  }

  /* --- Estados -------------------------------------------------------
     portada     giro base, marca sola en el centro
     rozando     el puntero esta encima: crece un poco y sale "Entrar"
     pulsado     crece del todo y acelera
     viajando    encoge, baja y se despliegan disco y letras
     mazo        ya asentado abajo                                      */

  :global(html[data-escena='rozando']) .logotipo { --crecida: 1.06; }

  :global(html[data-escena='pulsado']) .logotipo { --crecida: 1.13; }

  :global(html[data-escena='rozando']) .pista,
  :global(html[data-escena='pulsado']) .pista {
    translate: 0 0;
  }

  :global(html[data-escena='viajando']) .logotipo,
  :global(html[data-escena='mazo']) .logotipo {
    translate:
      calc(-0.34748 * var(--ancho-final))
      calc(50vh - var(--logo-margen) - 0.5 * var(--logo-alto));
  }

  :global(html[data-escena='viajando']) .logotipo-svg,
  :global(html[data-escena='mazo']) .logotipo-svg {
    width: var(--ancho-final);
  }

  :global(html[data-escena='viajando']) .disco,
  :global(html[data-escena='mazo']) .disco {
    transform: scale(1);
  }

  :global(html[data-escena='viajando']) .cortina,
  :global(html[data-escena='mazo']) .cortina {
    width: 514px;
  }

  :global(html[data-escena='viajando']) .letras-desliz,
  :global(html[data-escena='mazo']) .letras-desliz {
    transform: translateX(0);
  }

  :global(html[data-escena='viajando']) .disparador,
  :global(html[data-escena='mazo']) .disparador {
    pointer-events: none;
  }
</style>
