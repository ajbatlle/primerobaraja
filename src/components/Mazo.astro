---
import { Image } from 'astro:assets';
import arcanos from '../data/arcanos.json';

const archivos = import.meta.glob('../assets/cartas/*.webp', { eager: true });
const cartas = arcanos.map((a) => ({
  ...a,
  imagen: archivos[`../assets/cartas/${a.slug}.webp`].default,
  publicado: a.orden !== null,
}));
---

<section class="mazo" aria-label="El mazo">
  <div class="anillo">
    {
      cartas.map((c) => (
        <article class="pieza" data-slug={c.slug} data-publicado={String(c.publicado)}>
          <Image
            class="pieza-lamina"
            src={c.imagen}
            width={360}
            height={450}
            alt={`${c.numero} · ${c.nombre}`}
            loading="eager"
          />
          <p class="pieza-pie">
            <span class="pieza-numero">{c.numero}</span>
            <span class="pieza-nombre">{c.nombre}</span>
          </p>
        </article>
      ))
    }
  </div>
</section>

<style>
  /* El contenedor esta siempre presente y siempre visible: lo que cambia es
     la disposicion de las piezas dentro, que el script interpola. No hay
     opacidad ni visibility en ninguna parte. */
  .mazo {
    /* El anillo ocupa la pantalla entera y se centra en ella: el catalogo
       es el centro de la escena, no una banda superior. */
    position: fixed;
    inset: 0;
    z-index: 3;

    perspective: clamp(900px, 118vw, 1700px);
    perspective-origin: 50% 50%;

    /* Plegado no se toca; solo se vuelve navegable al desplegarse. */
    pointer-events: none;
  }

  .anillo {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }

  .pieza {
    --ancho: clamp(150px, 19vw, 260px);
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--ancho);
    /* -0.625 = media altura de la lamina (las cartas son 4:5). Centra la
       imagen en la pantalla; el pie cuelga por debajo. */
    margin: calc(var(--ancho) * -0.625) 0 0 calc(var(--ancho) * -0.5);
    transform-style: preserve-3d;
    will-change: transform;

    /* Una pieza que pasa del ecuador se ha puesto de canto: en ese punto su
       ancho aparente ya es cero, asi que dejar de pintar su reverso no corta
       nada. Es la salida del campo por rotacion, sin fundido. */
    backface-visibility: hidden;

    /* Sin transition: el movimiento continuo lo escribe el script frame a
       frame, y una transicion encima lo volveria pastoso. */
  }

  .pieza-lamina {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 3px;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.35);
  }

  /* Las no publicadas siguen en el mazo, apagadas. Es un estado permanente,
     no una transicion. */
  .pieza[data-publicado='false'] .pieza-lamina {
    filter: grayscale(0.75) brightness(0.82);
  }

  .pieza-pie {
    margin: 12px 0 0;
    display: flex;
    gap: 0.6em;
    align-items: baseline;
    justify-content: center;
    font-size: clamp(11px, 1.15vw, 14px);
    color: #111;
    white-space: nowrap;
  }

  .pieza-numero {
    font-variant-numeric: tabular-nums;
    opacity: 0.55;
  }

  .pieza-nombre { letter-spacing: 0.06em; }

  :global(html[data-escena='mazo']) .mazo {
    pointer-events: auto;
    cursor: grab;
  }

  .mazo.arrastrando { cursor: grabbing; }
</style>
