---
// Primero Baraja. Una sola pantalla: a la izquierda lo que se lee (barajar, la
// frase, los capitulos, de que se trata) y a la derecha la mesa, un panel de
// malla gris donde viven las 22 cartas. Las rutas son hash (#/carta/justicia).
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import FondoMar from '../components/FondoMar.astro';
import arcanos from '../data/arcanos.json';
import frases from '../data/frases.json';
import sitio from '../data/sitio.json';
import nosotros from '../data/nosotros.json';
import logotipo from '../assets/logotipo.svg?url';
import isotipo from '../assets/logo.svg?url';
import foto from '../assets/nosotros.webp';

const naipes = import.meta.glob('../assets/naipes/*.webp', { eager: true, import: 'default' });
const urlNaipe = async (slug) => (await getImage({ src: naipes[`../assets/naipes/${slug}.webp`], width: 420, format: 'webp' })).src;

const cartas = await Promise.all(arcanos.map(async (a, i) => ({ ...a, i, publicado: a.orden !== null, url: await urlNaipe(a.slug) })));
const publicadas = cartas.filter((c) => c.publicado).sort((a, b) => b.orden - a.orden);
const pronto = cartas.filter((c) => !c.publicado);
const filas = [...publicadas, ...pronto];
const bloques = [filas.slice(0, 11), filas.slice(11)];

// Frases cortas para la cinta: la primera que cabe de cada capitulo.
const cinta = publicadas
  .map((c) => (frases[c.slug]?.frases || []).find((f) => f.t.length <= 110))
  .filter(Boolean)
  .map((f) => f.t);

const datos = {
  show: sitio.spotifyShow,
  cartas: cartas.map(({ slug, nombre, numero, orden, spotify, publicado }) => ({ slug, nombre, numero, orden, spotify, publicado })),
  frases,
};
const fotoOpt = await getImage({ src: foto, width: 800, format: 'webp' });
---

<Base titulo="Primero Baraja" descripcion="Primero Baraja, un podcast sobre tarot. Baraja el mazo, recibe una carta y una frase dicha en el podcast.">
  <a class="salto" href="#contenido">Saltar al contenido</a>

  <!-- Las cartas: capa propia, decorativa. Lo accesible vive en las escenas. -->
  <div class="cartas" aria-hidden="true" id="cartas">
    {cartas.map((c) => (
      <div class="carta" data-slug={c.slug}>
        <div class="giro">
          <div class="cara dorso"><img src={isotipo} alt="" /></div>
          <div class="cara frente"><img src={c.url} alt="" draggable="false" /></div>
        </div>
      </div>
    ))}
  </div>

  <div class="malla" id="contenido">
    <header class="barra">
      <a class="logotipo" href="#/" aria-label="Primero Baraja, inicio"><img src={logotipo} alt="" /></a>
      <nav class="nav" aria-label="Principal">
        <button type="button" class="nav-barajar" id="nav-barajar">Barajar</button>
        <a href="#/capitulos" data-ruta="capitulos">Capítulos</a>
        <a href="#/sobre" data-ruta="sobre">De qué se trata</a>
      </nav>
    </header>

    <!-- La mesa -->
    <div class="mesa" id="mesa" aria-hidden="false">
      <FondoMar />
      <div class="foto"><img src={fotoOpt.src} width={fotoOpt.attributes.width} height={fotoOpt.attributes.height} alt={nosotros.fotoAlt} /></div>
      <button class="pila" type="button" id="pila" aria-label="Barajar el mazo"></button>
    </div>

    <div class="escenas">
      <!-- Mesa -->
      <section class="escena esc-mesa" id="esc-mesa" aria-label="Inicio">
        <p class="pequeno">{cartas.length} arcanos · {publicadas.length} capítulos</p>
        <button class="gigante" type="button" id="barajar"><span class="disco" aria-hidden="true"></span><span>Barajar</span></button>
      </section>

      <!-- Carta -->
      <section class="escena esc-carta" id="esc-carta" aria-labelledby="carta-titulo" inert>
        <div class="rotulo pequeno"><span id="carta-rotulo"></span><h1 class="pequeno" id="carta-titulo" style="font-weight:500;color:var(--tinta)"></h1></div>
        <p class="frase" id="carta-frase"></p>
        <p class="fuente" id="carta-fuente"></p>
        <div class="player" id="carta-player"></div>
        <div class="acciones">
          <button class="pastilla" type="button" id="otra-carta">Otra carta</button>
          <button class="pastilla pastilla--clara" type="button" id="otra-frase">Otra frase</button>
        </div>
      </section>

      <!-- Capítulos -->
      <section class="escena esc-capitulos" id="esc-capitulos" aria-labelledby="cap-titulo" inert>
        <h2 class="pequeno" id="cap-titulo" style="font-weight:500">Capítulos · {publicadas.length} de {cartas.length}</h2>
        <div class="listas">
          {bloques.map((bloque, b) => (
            <ul class="lista">
              {bloque.map((c, k) => (
                <li class="fila" style={`--i:${b * 11 + k}`}>
                  {c.publicado ? (
                    <a href={`#/carta/${c.slug}`} data-slug={c.slug}><span class="num">{String(c.orden).padStart(2, '0')}</span><span class="nom">{c.nombre}</span></a>
                  ) : (
                    <span class="pronto" data-slug={c.slug}><span class="num">··</span><span class="nom">{c.nombre}<span class="solo-lector">, por salir</span></span></span>
                  )}
                </li>
              ))}
            </ul>
          ))}
        </div>
      </section>

      <!-- De qué se trata -->
      <section class="escena esc-sobre" id="esc-sobre" aria-labelledby="sobre-titulo" inert>
        <h2 id="sobre-titulo">{nosotros.titulo}</h2>
        {nosotros.parrafos.map((p) => <p>{p}</p>)}
        <p class="firma">{nosotros.firma}</p>
        <ul>
          {nosotros.instagram.map((l) => <li><a href={l.url} target="_blank" rel="noopener">{l.usuario}</a></li>)}
        </ul>
      </section>
    </div>

    <div class="cinta" aria-hidden="true">
      <div class="cinta-pista">
        {[0, 1].map(() => cinta.map((t) => <span>{t}</span>))}
      </div>
    </div>
  </div>

  <p class="solo-lector" id="anuncio" aria-live="polite"></p>
  <div class="grilla" id="grilla" aria-hidden="true" hidden>{Array.from({ length: 12 }, () => <i></i>)}</div>
  <noscript><p style="position:fixed;left:20px;bottom:20px;z-index:10;background:#fff;padding:12px">Para barajar necesitas JavaScript. El podcast está en <a href="https://open.spotify.com/show/39AiEVQ4054hakrVORVblu">Spotify</a>.</p></noscript>

  <script type="application/json" id="datos" set:html={JSON.stringify(datos)} />
  <script>
    import { iniciar } from '../scripts/mesa.js';
    iniciar();
  </script>
</Base>
